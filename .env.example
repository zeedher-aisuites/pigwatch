# Copy this file to .env and replace secret placeholders for local use. Never commit .env.
PIGWATCH_ENVIRONMENT=development
PIGWATCH_BIND_ADDRESS=127.0.0.1
PIGWATCH_API_PORT=8000
PIGWATCH_DASHBOARD_PORT=5173

POSTGRES_DB=pigwatch
POSTGRES_USER=pigwatch
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://pigwatch:replace-with-a-local-only-password@postgres:5432/pigwatch

# MQTT host ports are always bound to 127.0.0.1 while anonymous access is enabled.
MQTT_PORT=1883
MQTT_WEBSOCKET_PORT=9001
MQTT_HOST=mqtt
MQTT_BROKER_PORT=1883
MQTT_CONSUMER_CLIENT_ID=pigwatch-ingestion-v1

# Optional host-run M2 simulator overrides. These are deliberately separate from the API's
# container-network MQTT_HOST value above.
PIGWATCH_SIMULATOR_CONFIG=configs/simulator.development.json
PIGWATCH_SIMULATOR_MQTT_HOST=127.0.0.1
PIGWATCH_SIMULATOR_MQTT_PORT=1883
PIGWATCH_SIMULATOR_CLIENT_ID=pigwatch-simulator-v1
PIGWATCH_SIMULATOR_CONNECT_TIMEOUT=5
PIGWATCH_SIMULATOR_PUBLISH_TIMEOUT=5
PIGWATCH_SIMULATOR_PUBLISH_ATTEMPTS=3
